{
  "name": "vect-lang",
  "displayName": "Vect Language",
  "description": "Syntax highlighting, autocomplete, and error checking for the Vect programming language",
  "version": "2.0.0",
  "publisher": "vect-lang",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:vect"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vect",
        "aliases": ["Vect", "vect"],
        "extensions": [".vect"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vect",
        "scopeName": "source.vect",
        "path": "./syntaxes/vect.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vect",
        "path": "./snippets/vect.json"
      }
    ]
  }
}
