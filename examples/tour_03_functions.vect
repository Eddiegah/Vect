# TOUR 3 — Functions & Recursion

# Simple function
fn square(n: int) -> int {
    return n * n
}
print(square(7))    # 49
print(square(12))   # 144

# Multiple parameters
fn bmi(weight: float, height: float) -> float {
    return weight / (height * height)
}
print(bmi(70.0, 1.75))  # 22.857...

# Recursive factorial
fn factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}
print(factorial(5))   # 120
print(factorial(10))  # 3628800

# Recursive Fibonacci
fn fib(n: int) -> int {
    if n <= 1 { return n }
    return fib(n-1) + fib(n-2)
}
var i = 0
while i <= 8 {
    print(fib(i))
    i = i + 1
}
# 0 1 1 2 3 5 8 13 21

# Void function (no return type)
fn greet(name: string) {
    print("Hello, " + name + "!")
}
greet("Eddie")
greet("Vect")
