# linear_system.vect -- vector and matrix operations
# Demonstrates: native vector/matrix literals, arithmetic, dot product, transpose

var v1 = [1.0, 2.0, 3.0]
var v2 = [4.0, 5.0, 6.0]

# Element-wise addition
var v3 = v1 + v2
print(v3)

# Dot product (using middle-dot operator)
var dp = v1 · v2
print(dp)

# Matrix definition and multiplication
var A = [[1.0, 2.0], [3.0, 4.0]]
var B = [[5.0, 6.0], [7.0, 8.0]]
var C = A @ B
print(C)

# Transpose
var At = T(A)
print(At)

# Scalar multiply
var v4 = v1 * 3.0
print(v4)
