# stdlib/math.vect — standard math utilities for Vect
# Import by copying into your program (single-file language for v1)

fn clamp(x: float, lo: float, hi: float) -> float {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

fn sign(x: float) -> float {
    if x > 0.0 { return 1.0 }
    if x < 0.0 { return -1.0 }
    return 0.0
}

fn max_f(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn min_f(a: float, b: float) -> float {
    if a < b { return a }
    return b
}

fn is_approx_equal(a: float, b: float, tol: float) -> bool {
    var diff = a - b
    if diff < 0.0 { diff = -diff }
    return diff < tol
}
