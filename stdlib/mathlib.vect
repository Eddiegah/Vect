# stdlib/mathlib.vect — Math utility library for Vect
# Import with: import "stdlib/mathlib.vect"

fn clamp(x: float, lo: float, hi: float) -> float {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t
}

fn sign(x: float) -> float {
    if x > 0.0 { return 1.0 }
    if x < 0.0 { return -1.0 }
    return 0.0
}

fn max_f(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

fn min_f(a: float, b: float) -> float {
    if a < b { return a }
    return b
}

fn is_between(x: float, lo: float, hi: float) -> bool {
    return x >= lo and x <= hi
}

fn pow_int(base: float, exp: int) -> float {
    var result = 1.0
    var i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}
